# ---- Alpaca PAPER credentials (get from https://app.alpaca.markets/paper/dashboard/overview) ----
ALPACA_KEY_ID=your_paper_key_here
ALPACA_SECRET=your_paper_secret_here

# ---- SAFETY: leave this true. Going live requires BOTH flags below. ----
ALPACA_PAPER=true
# I_UNDERSTAND_THIS_IS_REAL_MONEY=yes

# ---- capital & universe ----
STARTING_CAPITAL=5000
SYMBOLS=AMD,COIN,NVDA,TQQQ
MARKET_SYMBOL=SPY

# ---- strategy ----
BAR_MINUTES=5
HORIZON_BARS=3
MAX_HOLD_MINUTES=16
META_THRESHOLD=0.85
TRAIN_YEARS=2.0
RETRAIN_DAYS=7

# ---- execution ----
USE_LIMIT_ENTRY=true
LIMIT_OFFSET_FRAC=0.15
LIMIT_TTL_SECONDS=300
PT_MULT=0.7
SL_MULT=1.0

# ---- risk ----
RISK_PER_TRADE=0.005
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_KILL=0.03
MAX_TOTAL_DRAWDOWN=0.20
MAX_TRADES_PER_DAY=120

# ---- session (US/Eastern) ----
ENTRY_START=09:35
ENTRY_CUTOFF=15:40
FLATTEN_AT=15:55

# ---- ops ----
DRY_RUN=false
LOOP_SECONDS=20
DASHBOARD_PORT=8080

# ---- data-quality guards ----
MAX_BAR_AGE_MINUTES=10
MAX_PRICE_DRIFT_BPS=40
COOLDOWN_SECONDS=60
USE_SIP=false

# ---- market-regime filter (off: A/B backtest showed no reliable benefit) ----
MARKET_FILTER=false
MARKET_TREND_BARS=12
MARKET_TREND_BPS_LIMIT=15
PERF_EPOCH=
USE_STREAM=true
MAX_STREAM_AGE_S=180
USE_BRACKETS=true
MAX_PRICE_DRIFT_FRAC=0.40
MIN_PRICE_DRIFT_BPS=25
